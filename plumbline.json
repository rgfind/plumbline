{
  "capture": {
    "build": ["cargo", "build"],
    "command": ["plumb", "capabilities", "--json"]
  },
  "fixture": "tests/fixtures/contract/capabilities.pl.json",
  "normalize_meta": ["request_id", "elapsed_ms", "ts_iso"],
  "surfaces": ["README.md"],
  "package_allowlist": "cargo-include",
  "release": {
    "branch": "main",
    "remote": "origin",
    "verification": {
      "ci": [
        {"id": "format", "argv": ["cargo", "fmt", "--check"], "timeout_seconds": 120},
        {"id": "clippy", "argv": ["cargo", "clippy", "--all-targets", "--locked", "--", "-D", "warnings"], "timeout_seconds": 600},
        {"id": "test", "argv": ["cargo", "test", "--locked"], "timeout_seconds": 600}
      ],
      "release": [
        {"id": "publish-dry-run", "argv": ["cargo", "publish", "--dry-run", "--locked"], "timeout_seconds": 600}
      ],
      "github_actions": {
        "repository": "rgfind/plumbline",
        "workflow_path": ".github/workflows/ci.yml"
      }
    }
  },
  "claims": [
    {
      "id": "contract_version",
      "mode": "value",
      "fixture_path": "data.contract_version",
      "expected": "0.1"
    },
    {
      "id": "verb_set",
      "mode": "keys",
      "fixture_path": "data.verbs",
      "expected": ["check", "capture", "verify", "preflight", "release", "capabilities", "schema", "config", "conformance", "contract-doc", "robot-docs"]
    },
    {
      "id": "exit_code_set",
      "mode": "keys",
      "fixture_path": "data.exit_codes",
      "expected": ["0", "1", "2", "3", "4", "5", "6"]
    },
    {
      "id": "stray_block_family",
      "mode": "value",
      "fixture_path": "data.error_codes.STRAY_BLOCK.family",
      "expected": "GATE"
    }
  ]
}
